{
  "expo": {
    "name": "StockMate",
    "slug": "StockMate",
    "scheme": "stockmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.stockmate.app",
      "adaptiveIcon": {
        "backgroundColor": "#f3efec",
        "foregroundImage": "./assets/brand-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "StockMate",
      "shortName": "StockMate",
      "description": "A secure home for your stock workflow.",
      "themeColor": "#f86f0b",
      "backgroundColor": "#ededef",
      "display": "standalone",
      "favicon": "./assets/brand-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
